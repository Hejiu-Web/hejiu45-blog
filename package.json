{
  "name": "hl-blog",
  "version": "1.2.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --watch apps/server/src/index.js",
    "dev:api": "node --watch apps/server/src/index.js",
    "dev:web": "vite --config apps/web/vite.config.mjs",
    "build": "vite build --config apps/web/vite.config.mjs",
    "seed": "node apps/server/src/seed.js --reset",
    "seed:keep": "node apps/server/src/seed.js --reset --keep-settings",
    "bgm": "node apps/server/src/import-bgm.js",
    "start": "node apps/server/src/index.js",
    "rebuild:search": "node apps/server/src/rebuild-search.js",
    "audit:security": "node apps/server/src/security-audit.js",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "setup": "pnpm install && pnpm seed && pnpm build"
  },
  "dependencies": {
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
