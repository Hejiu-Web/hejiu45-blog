# ─────────────────────────────── 基础配置 ───────────────────────────────

# 服务端口（生产模式下同时托管前端静态文件）
PORT=8787

# 站点对外地址：微信授权回调、RSS、sitemap 都基于它生成
# 生产环境必须是 https，否则微信不接受回调域名
SITE_URL=https://your-domain.com

# 运行模式：production 会启用严格 CSP、Secure Cookie 与 HSTS
# NODE_ENV=production

# ─────────────────────────────── 安全相关 ───────────────────────────────

# 会话签名密钥：至少 32 位随机字符串，生产环境必填（不填服务会拒绝启动）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 作者账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-this-password

# 会话有效期与空闲超时（秒）
SESSION_TTL_SECONDS=1209600
SESSION_IDLE_SECONDS=604800

# Cookie 是否只走 HTTPS。生产环境保持 true；反向代理终结 TLS 时必须为 true
COOKIE_SECURE=true

# 反向代理层数：用 Nginx 反代时填 1；直连填 0
TRUST_PROXY=1

# ─────────────────────────── 上传大小（只需改这一处）───────────────────────────
#
# 单个文件上限。这是全站唯一的开关：
#   - 媒体库（图片/视频/音频）、封面、头像上传都读它
#   - 头像另有 5MB 的合理上限，但如果这里配得更小，以这里为准
#
# 支持带单位，也兼容纯字节（旧写法）：
#   500MB   → 500 兆（默认）
#   2GB     → 2 吉
#   10485760 → 10MB（纯数字按字节理解）
#
# ⚠️ 改完必须同步 Nginx，值要 ≥ 这里的上限：
#   client_max_body_size 500m;
# 启动时应用会把这个值换算好打印在日志里，照着抄即可。
#
# 已有上传中或正在运行的服务，改完需要重启才会生效。
UPLOADS_ENABLED=true
UPLOAD_MAX_BYTES=500MB

# IP 黑名单，逗号分隔
IP_DENYLIST=

# ─────────────────────────────── 微信登录 ───────────────────────────────

# 通道二选一：
#   website = 网站应用扫码登录（电脑端展示二维码，手机扫码确认）→ 推荐
#   mp      = 公众号网页授权（微信内打开页面直接授权，仅限已认证服务号）
WECHAT_CHANNEL=website

# 微信开放平台「网站应用」或认证服务号的 AppID / AppSecret
# AppSecret 只放在服务器，绝不要写进前端代码或提交到仓库
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信接口地址，一般不需要改（本地联调可指向模拟服务）
# WECHAT_API_BASE=https://api.weixin.qq.com

# 数据目录（可选，默认 apps/server/data）
# DATA_DIR=
